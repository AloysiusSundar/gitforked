            </div>

            <div class="flex justify-between items-center border-b border-outline-variant/15 pb-2">
              <span class="text-on-surface-variant uppercase">FEATURED PROJECT</span>
              <a href="https://yathirai-eight.vercel.app" target="_blank" class="text-primary-container hover:underline font-bold">Yathir.ai ↗</a>
            </div>
          </div>

          <!-- Technical Stack Badges -->
          <div class="mt-6 pt-4 border-t border-outline-variant/20">
            <div class="text-[10px] text-on-surface-variant uppercase mb-3 tracking-widest font-bold">
              TECHNICAL STACK & INFRASTRUCTURE
            </div>
            <div class="flex flex-wrap gap-1.5 max-h-[140px] overflow-y-auto pr-1">
              {techStack.map(skill => (
                <span class="text-[10px] uppercase text-primary bg-surface border border-outline-variant/30 px-2.5 py-1 font-mono hover:border-primary-container transition-colors">
                  {skill}
                </span>
              ))}
            </div>
          </div>

        </div>
      </div>

    </div>

    <!-- Bottom Scroll Indicator & Binary Grid Overlay -->
    <div class="max-w-7xl mx-auto w-full flex justify-between items-end z-10 pt-6">
      <a 
        href="#logs" 
        id="scroll-to-logs-btn"
        class="font-label text-xs uppercase tracking-widest text-on-surface-variant hover:text-primary-container flex items-center gap-2 transition-colors cursor-pointer"
