        <!-- Section Marker Header -->
        <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4 mb-12 border-b border-outline-variant/20 pb-6">
          <div>
            <div class="font-label text-xs text-secondary uppercase tracking-widest mb-2 font-bold flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-primary-container animate-pulse"></span>
              <span>[ 03 // PROJECTS & CODE ]</span>
            </div>
            <h2 class="font-headline text-3xl md:text-4xl font-bold tracking-tighter text-on-background flex items-center gap-3 uppercase">
              <span class="text-primary-container">&gt;</span> ACTIVE_REPOSITORIES
            </h2>
          </div>

          <a href={`${base}/projects`} class="font-label text-xs text-primary-container hover:underline tracking-widest uppercase font-bold bg-surface-container-lowest px-4 py-2 ghost-border">
            ALL_MODULES &gt;
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {projects.map(pj => (
            <ProjectCard 
              title={pj.data.title}
              description={pj.data.description}
              slug={pj.slug}
              github={pj.data.github}
              url={pj.data.url}
              tags={pj.data.tags}
            />
          ))}
        </div>
      </div>

      <!-- Section 03 Bottom Scroll Cue -->
      <div class="max-w-6xl mx-auto w-full flex justify-between items-center z-10 pt-6 border-t border-outline-variant/10">
        <a 
          href="#telemetry" 
          id="scroll-to-telemetry-btn"
          class="font-label text-xs uppercase tracking-widest text-on-surface-variant hover:text-primary-container flex items-center gap-2 transition-colors cursor-pointer"
        >
          <span>[ CONTINUE TO LIVE TELEMETRY ]</span>
          <span class="material-symbols-outlined text-sm animate-bounce">expand_more</span>
        </a>
        <span class="font-label text-[10px] text-outline-variant uppercase">// END_OF_REPOSITORIES_PREVIEW</span>
      </div>
    </section>
  )}

  <!-- SECTION 04: Full-Screen Viewport for Current Rhythms (Audio & Reading) -->
  <section class="min-h-[calc(100vh-77px)] flex flex-col justify-between py-16 px-8 md:px-24 border-b border-outline-variant/15 relative scroll-mt-[77px]" id="telemetry">
    <div class="max-w-6xl mx-auto w-full my-auto">
      <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4 mb-12 border-b border-outline-variant/20 pb-6">
        <div>
          <div class="font-label text-xs text-secondary uppercase tracking-widest mb-2 font-bold flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-primary-container animate-pulse"></span>
            <span>[ 04 // CURRENT_RHYTHMS ]</span>
          </div>
          <h2 class="font-headline text-3xl md:text-4xl font-bold tracking-tighter text-on-background flex items-center gap-3 uppercase">
            <span class="text-primary-container">&gt;</span> AUDIO & READING STATUS
          </h2>
        </div>

        <div class="font-label text-xs text-on-surface-variant ghost-border px-4 py-2 bg-surface-container-lowest">
          STREAM // <span class="text-primary-container font-bold">APPLE MUSIC + STORYGRAPH</span>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-stretch">
        <AppleMusicWidget />
        <ReadingWidget />
      </div>
    </div>

    <!-- Section 04 Bottom Scroll Cue -->
    <div class="max-w-6xl mx-auto w-full flex justify-between items-center z-10 pt-6 border-t border-outline-variant/10">
      <a 
        href="#about" 
        id="scroll-to-about-btn"
        class="font-label text-xs uppercase tracking-widest text-on-surface-variant hover:text-primary-container flex items-center gap-2 transition-colors cursor-pointer"
      >
        <span>[ CONTINUE TO ROOT DIRECTORY ]</span>
        <span class="material-symbols-outlined text-sm animate-bounce">expand_more</span>
      </a>
      <span class="font-label text-[10px] text-outline-variant uppercase">// END_OF_RHYTHMS_STREAM</span>
    </div>
  </section>

  <!-- SECTION 05: About Me / Root Directory Section -->
  <section class="py-24 px-8 md:px-24 bg-surface-container-lowest border-t border-outline-variant/15 scroll-mt-[77px]" id="about">
    <div class="max-w-6xl mx-auto">
      <div class="font-label text-xs text-secondary uppercase tracking-widest mb-2 font-bold flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-primary-container animate-pulse"></span>
        <span>[ 05 // ABOUT & IDENTITY ]</span>
      </div>

      <div class="flex flex-col md:flex-row gap-16 mt-6 md:items-center">
        <!-- Photo/Avatar Area -->
        <div class="w-full md:w-1/3 flex flex-col items-center justify-center self-center gap-4">
          <div class="aspect-square w-full max-w-[320px] bg-surface border border-outline-variant/30 relative overflow-hidden group p-2 rounded-sm shadow-[0_10px_30px_rgba(0,0,0,0.8)]">
            <div class="absolute top-4 left-4 font-label text-[10px] text-primary-container bg-surface/90 px-2 py-0.5 z-10 font-bold border border-primary-container/30">
              HelloThere.png
            </div>
            <img 
              src={`${base}/images/777413566_2291740011364540_5554255872499474372_n.png`} 
              alt="Joy Aloysius S"
              class="w-full h-full object-cover select-none group-hover:scale-105 transition-transform duration-500 rounded-sm"
            />
            <div class="absolute bottom-4 right-4 flex gap-2 z-10">
              <div class="w-2.5 h-2.5 bg-primary-container animate-pulse"></div>
