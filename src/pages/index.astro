            <span class="text-secondary">/var/log/</span> THOUGHT_STREAM.log
          </h2>
        </div>
        
        <a href={`${base}/posts`} class="font-label text-xs text-primary-container hover:underline tracking-widest uppercase font-bold bg-surface px-4 py-2 ghost-border">
          VIEW_ALL_LOGS ({thoughtStream.length}) &gt;
        </a>
      </div>

      <!-- Bento Cards Grid matching Review Card specs -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {thoughtStream.slice(0, 6).map(item => (
          <LogCard 
            type={item.type}
            collectionType={item.collectionType}
            title={item.title}
            category={item.category}
            rating={item.rating}
            date={item.date}
            slug={item.slug}
            description={item.description}
            status={item.status}
