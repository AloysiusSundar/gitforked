---
import BaseLayout from '../layouts/BaseLayout.astro';
import LogCard from '../components/LogCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import AppleMusicWidget from '../components/AppleMusicWidget.astro';
import ReadingWidget from '../components/ReadingWidget.astro';
import { getCollection } from 'astro:content';

const reviews = await getCollection('reviews');
const posts = await getCollection('posts');
const projects = await getCollection('projects');

const thoughtStream = [
  ...reviews.map(r => ({
    collectionType: 'reviews' as const,
    type: (r.data.type || 'REVIEW').toUpperCase(),
    order: r.data.order,
    title: r.data.title,
    category: r.data.category,
    rating: r.data.rating,
    date: r.data.date,
    slug: r.slug,
    description: r.data.description,
    status: r.data.status,
  })),
  ...posts.map(p => ({
    collectionType: 'posts' as const,
    type: (p.data.type || 'ESSAY').toUpperCase(),
    order: p.data.order,
    title: p.data.title,
    category: p.data.category,
    rating: undefined,
    date: p.data.date,
    slug: p.slug,
    description: p.data.description,
    status: 'LOGGED',
  })),
].sort((a, b) => {
  if (a.order !== undefined && b.order !== undefined) return a.order - b.order;
  if (a.order !== undefined) return -1;
  if (b.order !== undefined) return 1;
  return new Date(b.date).getTime() - new Date(a.date).getTime();
});

const techStack = [
  'Python',
  'FastAPI',
  'LLMs & Transformers',
  'PyTorch',
  'GraphRAG',
  'Model Context Protocol (MCP)',
  'Agentic Workflows',
  'Vector DBs (Pinecone/Chroma)',
  'PostgreSQL / Supabase',
  'Redis',
  'Docker',
  'OpenTelemetry',
  'WebRTC',
  'TypeScript',
  'Astro'
];

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL.slice(0, -1) : import.meta.env.BASE_URL;
---

<BaseLayout title="GITFORKED — Joy Aloysius S | Portfolio & Thought Stream">

  <!-- SECTION 01: Full-Screen Hero Viewport -->
  <section class="min-h-[calc(100vh-77px)] flex flex-col justify-between px-8 md:px-24 py-12 relative overflow-hidden ghost-border-b bg-[radial-gradient(circle_at_70%_45%,_rgba(0,255,65,0.07)_0%,_transparent_65%)]">
    <div></div> <!-- Top spacer -->

    <div class="max-w-7xl mx-auto w-full grid grid-cols-1 lg:grid-cols-12 gap-12 items-center z-10 my-auto">
      
      <!-- Left Hero Content -->
      <div class="lg:col-span-7">
        <div class="font-label text-secondary mb-4 text-xs md:text-sm tracking-widest uppercase font-bold flex items-center gap-2.5">
          <span class="w-2.5 h-2.5 rounded-full bg-primary-container animate-pulse"></span>
          <span>[ 01 // OVERVIEW ] JOY ALOYSIUS S // SOFTWARE ENGINEER & WRITER</span>
        </div>

        <h1 class="font-headline text-6xl md:text-8xl font-extrabold tracking-tighter text-on-background mb-4 leading-none uppercase">
          <span class="text-primary-container">&gt;</span> GITFORKED<span class="blinking-cursor text-primary-container">_</span>
        </h1>

        <p class="font-headline text-xl md:text-2xl text-primary font-bold max-w-2xl leading-relaxed mb-3 uppercase tracking-tight">
          Building Intelligent Systems. Writing Whatever.
        </p>

        <blockquote class="font-label text-[11px] md:text-xs text-secondary border-l-2 border-secondary pl-3.5 py-1 mb-6 uppercase tracking-wider bg-surface/50 leading-relaxed">
          "Our lives slip away, moment by moment, lost in the vast terrible in between. But there is still time to seize that one last fragile moment."
          <span class="text-on-surface-variant/70 font-normal tracking-normal lowercase ml-1 block md:inline mt-1 md:mt-0">// j. michael straczynski</span>
        </blockquote>

        <div class="font-body text-base md:text-lg text-on-surface-variant max-w-2xl leading-relaxed mb-10 space-y-4 font-normal">
          <p>
            I’m a software engineer interested in building intelligent systems and making complicated things work at scale. I like digging into problems where the interesting part starts after the obvious solution.
          </p>
          <p>
            Outside of engineering, I write about the occasional thought I’ve been unable to leave alone.
          </p>
        </div>

        <!-- CTA Buttons -->
        <div class="flex gap-4 flex-wrap font-label">
          <a 
            href={`${base}/projects`}
            class="bg-primary-container text-on-primary uppercase tracking-widest text-sm px-8 py-4 hover:bg-primary transition-colors duration-200 flex items-center gap-2 font-bold shadow-[0_0_25px_rgba(0,255,65,0.25)]"
          >
            <span>EXPLORE_PROJECTS</span>
            <span class="material-symbols-outlined text-sm">arrow_forward</span>
          </a>

          <a 
            href={`${base}/posts`}
            class="bg-transparent border border-outline-variant/40 text-primary uppercase tracking-widest text-sm px-8 py-4 hover:border-primary-container transition-colors duration-200"
          >
            &gt; READ_THOUGHT_STREAM
          </a>
        </div>
      </div>

      <!-- Right Feature Card (Clean At-A-Glance Profile with GitHub Badge) -->
      <div class="lg:col-span-5">
        <div class="bg-surface-container-lowest ghost-border p-8 font-label text-xs crt-glow relative rounded-sm shadow-[0_0_50px_rgba(0,0,0,0.8)] border border-outline-variant/30">
          
          <!-- Card Header -->
          <div class="flex items-center justify-between border-b border-outline-variant/20 pb-4 mb-6">
            <div class="flex items-center gap-3">
              <span class="w-3 h-3 rounded-full bg-primary-container inline-block animate-ping"></span>
              <span class="text-primary font-bold tracking-widest uppercase text-sm">AT_A_GLANCE</span>
            </div>
            <a 
              href="https://github.com/AloysiusSundar" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="text-primary-container font-bold text-[10px] bg-surface px-2.5 py-1 border border-outline-variant/30 hover:border-primary-container transition-colors flex items-center gap-1"
            >
              <span>GITHUB // @AloysiusSundar</span>
              <span>↗</span>
            </a>
          </div>

          <!-- Highlight Rows -->
          <div class="space-y-4 text-xs font-mono">
            <div class="flex justify-between items-center border-b border-outline-variant/15 pb-2">
              <span class="text-on-surface-variant uppercase">CURRENT ROLE</span>
              <span class="text-primary font-bold">Software Engineer @ Cogniwide UK</span>
            </div>

            <div class="flex justify-between items-center border-b border-outline-variant/15 pb-2">
              <span class="text-on-surface-variant uppercase">EDUCATION</span>
              <span class="text-on-background">B.Tech CSE @ VIT Vellore</span>
            </div>

            <div class="flex justify-between items-center border-b border-outline-variant/15 pb-2">
              <span class="text-on-surface-variant uppercase">FEATURED ESSAY</span>
