---
interface Props {
  bookTitle?: string;
  author?: string;
  genre?: string;
  coverUrl?: string;
  storyGraphUrl?: string;
  description?: string;
  pages?: string;
  publishedYear?: string;
  publisher?: string;
}

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL.slice(0, -1) : import.meta.env.BASE_URL;

const { 
  bookTitle = "Convenience Store Woman", 
  author = "Sayaka Murata",
  genre = "LITERATURE",
  coverUrl = `${base}/images/CSW.jpg`,
  storyGraphUrl = "https://app.thestorygraph.com/books/9a4fbf48-0682-4142-9b51-3784a7f47246",
  description = "A brilliant, quirky, and hilarious portrait of modern conformity, societal expectations, and finding quiet fulfillment in a convenience store rhythm.",
  pages = "163 PAGES",
  publishedYear = "2016",
  publisher = "GROVE PRESS"
} = Astro.props;
---

<div class="bg-surface-container-lowest ghost-border p-8 hover:bg-surface-container-low transition-colors duration-300 flex flex-col justify-between h-full min-h-[520px] relative">
  <div class="flex-1 flex flex-col justify-between">
    <!-- Top Header Bar -->
    <div class="flex items-center justify-between gap-2 mb-4">
      <span class="font-label text-xs text-secondary font-bold tracking-widest uppercase">
        [ NOW // CURRENT READ ]
      </span>
      <span class="font-label text-[10px] uppercase text-on-surface-variant ghost-border px-2 py-0.5 font-bold">
        STORYGRAPH
      </span>
    </div>

    <h3 class="font-headline text-xl font-bold text-on-background mb-4 uppercase">
      What I'm Reading Currently
    </h3>

    <!-- Inner Elevated Container Spanning Full Height -->
    <div class="ghost-border p-6 bg-surface mb-4 flex-1 flex flex-col justify-between items-center text-center">
      
      <!-- 1. TOP: Genre Tag & Book Title (Left Aligned) -->
      <div class="w-full text-left">
        <div class="font-label text-xs text-primary-container uppercase font-normal mb-1">
          [ {genre} ]
        </div>
        <h4 class="font-headline font-bold text-2xl md:text-3xl text-primary leading-tight mb-2">
          {bookTitle}
        </h4>
      </div>

      <!-- 2. MIDDLE: Large Book Cover -->
      <div class="my-4 flex justify-center items-center">
        <div class="relative group aspect-[2/3] h-80 sm:h-96 w-56 sm:w-64 overflow-hidden rounded-md border border-outline-variant/30 shadow-[0_20px_45px_rgba(0,0,0,0.9)] hover:border-primary-container/50 transition-all duration-300">
          <img 
            src={coverUrl} 
            alt={bookTitle} 
            class="w-full h-full object-cover select-none group-hover:scale-105 transition-transform duration-300"
          />
        </div>
      </div>

      <!-- 3. BOTTOM: Author, Metadata Pills & Description (Centered) -->
      <div class="w-full flex flex-col items-center justify-center text-center pt-2">
        <p class="font-label text-xs text-secondary uppercase tracking-wider font-bold mb-3">
          by {author}
        </p>

        <!-- Metadata Pills Centered -->
        <div class="flex flex-wrap justify-center gap-2 font-mono text-[10px] uppercase mb-4">
          <span class="bg-surface-container-lowest border border-outline-variant/30 text-on-surface-variant px-2.5 py-1 font-bold">
            {pages}
          </span>
          <span class="bg-surface-container-lowest border border-outline-variant/30 text-on-surface-variant px-2.5 py-1 font-bold">
            PUB // {publishedYear}
          </span>
          <span class="bg-surface-container-lowest border border-outline-variant/30 text-on-surface-variant px-2.5 py-1 font-bold">
            {publisher}
          </span>
        </div>

        <!-- Description Blurb -->
        <div class="border-t border-outline-variant/15 pt-4 w-full">
          <p class="font-body text-xs md:text-sm text-on-surface-variant leading-relaxed text-center">
            {description}
          </p>
        </div>
      </div>

    </div>
  </div>

  <!-- Footer -->
  <div class="border-t border-outline-variant/20 pt-4 mt-auto flex justify-between items-center font-label text-xs">
    <a 
      href={storyGraphUrl} 
      target="_blank" 
      rel="noopener noreferrer" 
      class="text-primary-container hover:underline font-bold flex items-center gap-1"
    >
      VIEW_ON_STORYGRAPH ↗
    </a>
    <span class="text-on-surface-variant uppercase">// LITERATURE_STREAM</span>
  </div>
</div>
