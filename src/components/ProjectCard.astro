---
interface Props {
  title: string;
  description: string;
  slug: string;
  url?: string;
  github?: string;
  tags?: string[];
}

const { title, description, slug, url, github, tags = [] } = Astro.props;

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL.slice(0, -1) : import.meta.env.BASE_URL;
const projectUrl = `${base}/projects/${slug}`;
---

<div class="bg-surface-container-lowest ghost-border p-8 hover:bg-surface-container-low hover:-translate-y-1.5 hover:border-primary-container/40 hover:shadow-[0_0_30px_rgba(0,255,65,0.08)] transition-all duration-300 flex flex-col justify-between group h-[340px] relative overflow-hidden">
  <!-- Card Background Click Target -->
  <a href={projectUrl} class="absolute inset-0 z-0" aria-label={`View ${title} details`}></a>

  <div class="relative z-10 pointer-events-none">
    <div class="flex justify-between items-start mb-4">
      <span class="font-label text-xs text-primary-container font-bold tracking-widest uppercase">
        [ REPOSITORY ]
      </span>
      <span class="material-symbols-outlined text-secondary opacity-50 group-hover:opacity-100 transition-opacity">call_split</span>
    </div>

    <h3 class="font-headline text-xl font-bold text-on-background mb-3 uppercase leading-tight group-hover:text-primary transition-colors">
      {title}
    </h3>

    <p class="font-body text-sm text-on-surface-variant line-clamp-3 leading-relaxed mb-4">
      {description}
    </p>
  </div>

  <div class="relative z-10">
    {tags.length > 0 && (
      <div class="flex flex-wrap gap-1.5 mb-4 pointer-events-none">
        {tags.slice(0, 3).map((tag) => (
          <span class="font-label text-[10px] uppercase text-on-surface-variant bg-surface border border-outline-variant/30 px-2 py-0.5">
            {tag}
          </span>
        ))}
      </div>
    )}

    <div class="font-label text-xs uppercase tracking-widest flex items-center justify-between border-t border-outline-variant/20 pt-4 mt-auto">
      <a href={projectUrl} class="text-primary-container font-bold hover:underline flex items-center gap-1 z-20">
        [ DOCS &gt; ]
      </a>
      
      <div class="flex items-center gap-3">
        {github && (
          <a href={github} target="_blank" rel="noopener noreferrer" class="text-secondary hover:underline flex items-center gap-1 font-bold z-20">
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
            </svg>
            <span>SOURCE ↗</span>
          </a>
        )}
        {url && (
          <a href={url} target="_blank" rel="noopener noreferrer" class="text-primary hover:underline flex items-center gap-1 font-bold z-20">
            <span class="material-symbols-outlined text-xs">rocket_launch</span>
            <span>DEMO ↗</span>
          </a>
        )}
      </div>
    </div>
  </div>
</div>
