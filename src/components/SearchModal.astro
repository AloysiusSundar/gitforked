---
import { getCollection } from 'astro:content';

const posts = await getCollection('posts');
const reviews = await getCollection('reviews');
const projects = await getCollection('projects');

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL.slice(0, -1) : import.meta.env.BASE_URL;

const searchIndex = [
  ...reviews.map(r => ({
    type: 'REVIEW',
    title: r.data.title,
    category: r.data.category,
    rating: r.data.rating,
    url: `${base}/reviews/${r.slug}`,
    tags: r.data.tags || []
  })),
  ...posts.map(p => ({
    type: 'ESSAY',
    title: p.data.title,
    category: p.data.category,
    rating: null,
    url: `${base}/posts/${p.slug}`,
    tags: p.data.tags || []
  })),
  ...projects.map(pj => ({
    type: 'PROJECT',
    title: pj.data.title,
    category: 'Code',
    rating: null,
    url: `${base}/projects/${pj.slug}`,
    tags: pj.data.tags || []
  }))
];
---

<dialog id="search-dialog" class="bg-[var(--color-zen-surface)] border border-[rgba(0,255,65,0.4)] text-[var(--color-zen-light)] rounded-none p-0 w-full max-w-2xl shadow-[0_0_50px_rgba(0,255,65,0.15)] backdrop:bg-[rgba(5,5,5,0.85)]">
  <div class="p-4 ghost-border-b flex items-center justify-between gap-3 bg-[var(--color-zen-surface-low)]">
    <div class="flex items-center gap-2 flex-1">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-zen-neon)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      <input 
        id="search-input" 
        type="text" 
        placeholder="Search reviews, essays, tags, projects..." 
        class="w-full bg-transparent border-none outline-none font-mono text-sm text-[var(--color-zen-light)] placeholder-[var(--color-zen-muted)]"
      />
    </div>
    <button id="close-search-btn" class="font-mono text-xs text-[var(--color-zen-muted)] hover:text-[var(--color-zen-neon)] px-2 py-1 border border-[rgba(59,75,55,0.3)]">
      ESC
    </button>
  </div>

  <div id="search-results" class="max-h-[60vh] overflow-y-auto p-4 flex flex-col gap-2">
    <!-- Dynamic Results rendered via script below -->
  </div>

  <div class="p-3 ghost-border-t bg-[var(--color-zen-surface-low)] flex justify-between items-center font-mono text-[10px] text-[var(--color-zen-muted)]">
    <span>SYSTEM_INDEX // {searchIndex.length} ITEMS</span>
    <span>USE ARROWS / ENTER TO NAVIGATE</span>
  </div>
</dialog>

<script is:inline define:vars={{ searchIndex }}>
  document.addEventListener('DOMContentLoaded', () => {
    const dialog = document.getElementById('search-dialog');
    const openBtn = document.getElementById('open-search-btn');
    const closeBtn = document.getElementById('close-search-btn');
    const input = document.getElementById('search-input');
    const resultsContainer = document.getElementById('search-results');

    function renderResults(query = '') {
      const q = query.toLowerCase().trim();
      const filtered = q 
        ? searchIndex.filter(item => 
            item.title.toLowerCase().includes(q) || 
            item.category.toLowerCase().includes(q) ||
            item.type.toLowerCase().includes(q) ||
            item.tags.some(t => t.toLowerCase().includes(q))
          )
        : searchIndex;

      if (filtered.length === 0) {
        resultsContainer.innerHTML = `<div class="p-6 text-center font-mono text-xs text-[var(--color-zen-dark)]">NO TELEMETRY MATCHES FOUND FOR "${q}"</div>`;
        return;
      }

      resultsContainer.innerHTML = filtered.map(item => `
        <a href="${item.url}" class="p-3 ghost-border hover:bg-[rgba(0,255,65,0.06)] hover:border-[var(--color-zen-neon)] flex items-center justify-between gap-4 transition-all group">
          <div>
            <div class="flex items-center gap-2 mb-1">
              <span class="font-mono text-[9px] uppercase tracking-widest text-[var(--color-zen-neon)] px-1.5 py-0.5 border border-[rgba(0,255,65,0.3)]">
                ${item.type}
              </span>
              <span class="font-mono text-[10px] text-[var(--color-zen-muted)] uppercase">${item.category}</span>
            </div>
            <h4 class="font-headline font-bold text-sm text-[var(--color-zen-light)] group-hover:text-[var(--color-zen-neon)]">
              ${item.title}
            </h4>
          </div>
          ${item.rating ? `<span class="font-mono text-xs text-[var(--color-zen-neon)] font-bold">★ ${item.rating}/5</span>` : '<span class="font-mono text-xs text-[var(--color-zen-muted)]">&gt;</span>'}
        </a>
      `).join('');
    }

    if (openBtn && dialog) {
      openBtn.addEventListener('click', () => {
        dialog.showModal();
        renderResults('');
        input.focus();
      });
    }

    if (closeBtn && dialog) {
      closeBtn.addEventListener('click', () => dialog.close());
    }

    if (input) {
      input.addEventListener('input', (e) => renderResults(e.target.value));
    }

    // Keyboard shortcut (Cmd+K / Ctrl+K)
    window.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        if (dialog.open) {
          dialog.close();
        } else {
          dialog.showModal();
          renderResults('');
          input.focus();
        }
      }
    });
  });
</script>
