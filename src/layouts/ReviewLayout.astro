---
import BaseLayout from './BaseLayout.astro';
import ReadingProgress from '../components/ReadingProgress.astro';

interface Props {
  title: string;
  category: string;
  rating: number;
  date: Date | string;
  status?: string;
  coverImage?: string;
  tags?: string[];
  description?: string;
}

const { title, category, rating, date, status = 'RECOMMENDED', coverImage, tags = [], description } = Astro.props;

const formattedDate = new Date(date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL.slice(0, -1) : import.meta.env.BASE_URL;

const fullStars = Math.floor(rating);
const starsStr = '★'.repeat(fullStars) + '☆'.repeat(5 - fullStars);
---

<BaseLayout title={`${title} (Review) // GIT FORKED`} description={description}>
  <ReadingProgress />

  <article class="max-w-4xl mx-auto py-12 px-4 sm:px-6">
    
    <!-- Top Telemetry & Back Link -->
    <div class="flex items-center justify-between gap-4 mb-8 pb-4 border-b border-outline-variant/15 font-mono text-xs">
      <a href={`${base}/posts`} class="text-primary-container hover:underline font-bold flex items-center gap-1">
        &lt; ALL_ENTRIES
      </a>
      <span class="text-on-surface-variant/70 uppercase tracking-widest text-[10px]">
        [ CRITIQUE_NODE // {category} ]
      </span>
    </div>

    <!-- Unified Container for Header + Content -->
    <div class="bg-surface ghost-border p-6 sm:p-10 shadow-[0_15px_40px_rgba(0,0,0,0.8)]">
      
      <!-- Review Header -->
      <header class="border-b border-outline-variant/20 pb-8 mb-8">
        <div class="flex items-center gap-3 mb-4">
          <span class="font-mono text-xs text-primary-container ghost-border px-3 py-1 font-bold uppercase tracking-wider">
            VERDICT: {status}
          </span>
          <span class="font-mono text-base text-primary-container font-bold">
            {starsStr} ({rating}/5)
          </span>
        </div>

        <h1 class="font-headline text-3xl sm:text-4xl md:text-5xl font-extrabold text-on-background uppercase tracking-tight leading-tight mb-6">
          {title}
        </h1>

        <div class="flex flex-wrap items-center gap-4 font-mono text-xs text-on-surface-variant bg-surface-container-lowest ghost-border p-4 mb-6">
          <div>
            <span class="text-on-surface-variant/60 uppercase">CATEGORY //</span>
            <span class="text-on-background font-bold">{category}</span>
          </div>
          <span>•</span>
          <div>
            <span class="text-on-surface-variant/60 uppercase">REVIEWED //</span>
            <span class="text-primary-container font-bold">{formattedDate}</span>
          </div>
          {tags.length > 0 && (
            <>
              <span>•</span>
              <div class="flex items-center gap-2">
                {tags.map((tag) => (
                  <span class="text-[10px] text-on-surface-variant ghost-border px-2 py-0.5 uppercase">
                    #{tag}
                  </span>
                ))}
              </div>
            </>
          )}
        </div>

        {coverImage && (
          <div class="w-full h-[360px] rounded overflow-hidden ghost-border bg-surface-container-lowest">
            <img src={coverImage} alt={title} class="w-full h-full object-cover" />
          </div>
        )}
      </header>

      <!-- Markdown Article Body -->
      <div class="prose max-w-none">
        <slot />
      </div>

    </div>

    <!-- Footer Back Link -->
    <div class="mt-12 pt-6 border-t border-outline-variant/15 flex justify-between items-center font-mono text-xs">
      <a href={`${base}/posts`} class="text-primary-container hover:underline font-bold">
        &lt; BACK_TO_LOGS
      </a>
      <span class="text-outline-variant uppercase">// END_OF_CRITIQUE</span>
    </div>

  </article>
</BaseLayout>
