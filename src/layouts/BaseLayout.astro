---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchModal from '../components/SearchModal.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "GITFORKED | SYSTEM_INIT", 
  description = "A personal viewport for film/TV reviews, anime critiques, tech projects, and philosophical yaps by Joy Aloysius." 
} = Astro.props;

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL.slice(0, -1) : import.meta.env.BASE_URL;
---

<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/x-icon" href={`${base}/favicon.ico`} />

    <!-- OpenGraph / Social Meta -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body class="font-body antialiased min-h-screen flex flex-col selection:bg-[var(--primary-container)] selection:text-[var(--on-primary)] relative">
    <!-- CRT Scanline Effect Overlay -->
    <div class="scanlines"></div>

    <Header />
    <main id="main-content" class="flex-grow flex flex-col w-full">
      <slot />
    </main>
    <Footer />
    <SearchModal />
  </body>
</html>
