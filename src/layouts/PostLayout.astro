---
import BaseLayout from './BaseLayout.astro';
import ReadingProgress from '../components/ReadingProgress.astro';

interface Props {
  title: string;
  category: string;
  date: Date | string;
  author?: string;
  tags?: string[];
  description?: string;
  image?: string;
  coverImage?: string;
}

const { title, category, date, author = 'Joy Aloysius', tags = [], description, image, coverImage } = Astro.props;
const heroImage = image || coverImage;

const formattedDate = new Date(date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL.slice(0, -1) : import.meta.env.BASE_URL;

const resolveImagePath = (path?: string) => {
  if (!path) return '';
  if (path.startsWith('http://') || path.startsWith('https://')) return path;
  if (base && path.startsWith(base)) return path;
  const clean = path.startsWith('/') ? path : `/${path}`;
  return `${base}${clean}`;
};
---

<BaseLayout title={`${title} // GIT FORKED`} description={description}>
  <ReadingProgress />

  <article class="max-w-4xl mx-auto py-12 px-4 sm:px-6">
    
    <!-- Top Telemetry & Back Button -->
    <div class="flex items-center justify-between gap-4 mb-8 pb-4 border-b border-outline-variant/15 font-mono text-xs">
      <a href={`${base}/posts`} class="text-primary-container hover:underline font-bold flex items-center gap-1">
        &lt; ALL_ENTRIES
      </a>
      <span class="text-on-surface-variant/70 uppercase tracking-widest text-[10px]">
        [ ESSAY_NODE // {category} ]
      </span>
    </div>

    <!-- Unified Container for Header + Content -->
    <div class="bg-surface ghost-border p-6 sm:p-10 shadow-[0_15px_40px_rgba(0,0,0,0.8)]">
      
      <!-- Article Header -->
      <header class="border-b border-outline-variant/20 pb-8 mb-8">
        <h1 class="font-headline text-3xl sm:text-4xl md:text-5xl font-extrabold text-on-background uppercase tracking-tight leading-tight mb-6">
          {title}
        </h1>

        <div class="flex flex-wrap items-center gap-4 font-mono text-xs text-on-surface-variant bg-surface-container-lowest ghost-border p-4">
          <div>
            <span class="text-on-surface-variant/60 uppercase">AUTHOR //</span>
            <span class="text-on-background font-bold">{author}</span>
          </div>
          <span>•</span>
          <div>
            <span class="text-on-surface-variant/60 uppercase">PUBLISHED //</span>
            <span class="text-primary-container font-bold">{formattedDate}</span>
          </div>
          {tags.length > 0 && (
            <>
              <span>•</span>
              <div class="flex items-center gap-2">
                {tags.map((tag) => (
                  <span class="text-[10px] text-on-surface-variant ghost-border px-2 py-0.5 uppercase">
                    #{tag}
                  </span>
                ))}
              </div>
            </>
          )}
        </div>

        {heroImage && (
          <div class="-mx-4 sm:-mx-10 md:-mx-16 my-8 overflow-hidden rounded-lg ghost-border shadow-[0_20px_50px_rgba(0,0,0,0.9)] bg-surface-container-lowest relative z-10 max-h-[380px] sm:max-h-[440px]">
            <img 
              src={resolveImagePath(heroImage)} 
              alt={title} 
              class="w-full h-full max-h-[380px] sm:max-h-[440px] object-cover block" 
            />
          </div>
        )}
      </header>

      <!-- Markdown Article Body -->
      <div class="prose max-w-none">
        <slot />
      </div>

    </div>

    <!-- Footer Back Link -->
    <div class="mt-12 pt-6 border-t border-outline-variant/15 flex justify-between items-center font-mono text-xs">
      <a href={`${base}/posts`} class="text-primary-container hover:underline font-bold">
        &lt; BACK_TO_LOGS
      </a>
      <span class="text-outline-variant uppercase">// END_OF_TRANSMISSION</span>
    </div>

  </article>
</BaseLayout>
